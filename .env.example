# Copy to .env and fill in real values. Never commit .env.

# Tavily Search API (research step) - https://app.tavily.com
TAVILY_API_KEY=

# Kie.ai (Nano Banana image generation) - https://kie.ai/api-key
KIE_API_KEY=
# Optional: google/nano-banana (default, cheapest) or google/nano-banana-pro (higher quality, ~6x cost)
KIE_MODEL=google/nano-banana

# Anthropic (auto topic-picking + brief synthesis for the scheduled Trigger.dev run) - https://console.anthropic.com
ANTHROPIC_API_KEY=

# Gmail sending: interactive local runs use credentials.json/token.json (OAuth browser flow).
# Headless runs (Trigger.dev) use these instead - leave blank locally.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Google Drive: interactive local runs (this Claude Code session) use the Claude Code
# Google Drive MCP connector (already authorized against Growth@monk10x.com) - no keys
# needed for that. The scheduled Trigger.dev run instead uses tools/drive_client.py with
# the GOOGLE_* vars above. See workflows/newsletter_automation.md for details.
