# Copy to .env and fill in real values. Never commit .env.

# Tavily Search API (research step) - https://app.tavily.com
TAVILY_API_KEY=

# Kie.ai (Nano Banana image generation) - https://kie.ai/api-key
KIE_API_KEY=
# Optional: google/nano-banana (default, cheapest) or google/nano-banana-pro (higher quality, ~6x cost)
KIE_MODEL=google/nano-banana

# Gmail sending and Google Drive storage use the Claude Code Gmail/Google Drive
