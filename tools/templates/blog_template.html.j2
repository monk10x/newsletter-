<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }}</title>
</head>
<body style="margin:0; padding:0; background-color:#F5F5F5; font-family:{{ font_body }};">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#F5F5F5;">
<tr><td align="center" style="padding:24px 16px;">
<table role="presentation" width="680" cellpadding="0" cellspacing="0" style="max-width:680px; width:100%; background-color:{{ white }};">

<!-- Header -->
<tr>
<td style="background-color:{{ white }}; padding:28px 32px; border-bottom:1px solid #E5E5E5;" align="left">
<img src="cid:{{ logo_cid }}" alt="Monk10x" width="160" style="display:block; border:0;">
</td>
</tr>

<!-- Meta -->
<tr>
<td style="padding:24px 32px 0 32px;">
<p style="margin:0; font-family:{{ font_mono }}; font-size:12px; letter-spacing:0.06em; text-transform:uppercase; color:{{ system_gray }};">
Monk10x Blog &mdash; {{ date_label }}
</p>
</td>
</tr>

<!-- Title -->
<tr>
<td style="padding:8px 32px 0 32px;">
<h1 style="margin:0; font-family:{{ font_display }}; font-weight:700; font-size:32px; line-height:1.2; color:{{ monk_black }};">
{{ title }}
</h1>
</td>
</tr>

<!-- Deck -->
<tr>
<td style="padding:14px 32px 0 32px;">
<p style="margin:0; font-family:{{ font_body }}; font-size:17px; line-height:1.6; color:{{ system_gray }};">
{{ deck }}
</p>
</td>
</tr>

<!-- Hero image -->
<tr>
<td style="padding:24px 32px 0 32px;">
<img src="cid:{{ hero_cid }}" alt="{{ title }}" width="616" style="display:block; width:100%; max-width:616px; height:auto; border:1px solid #E5E5E5;">
</td>
</tr>

{% for section in sections %}
<tr>
<td style="padding:28px 32px 0 32px;">
<h2 style="margin:0 0 10px 0; font-family:{{ font_display }}; font-weight:600; font-size:20px; line-height:1.35; color:{{ monk_black }};">
{{ section.heading }}
</h2>
{% for para in section.paragraphs %}
<p style="margin:0 0 14px 0; font-family:{{ font_body }}; font-size:16px; line-height:1.65; color:{{ monk_black }};">
{{ para }}
</p>
{% endfor %}
</td>
</tr>
{% if section.image_after %}
<tr>
<td style="padding:8px 32px 0 32px;">
<img src="cid:{{ support_cid }}" alt="{{ section.heading }}" width="616" style="display:block; width:100%; max-width:616px; height:auto; border:1px solid #E5E5E5;">
</td>
</tr>
{% endif %}
{% endfor %}

<!-- Sources -->
<tr>
<td style="padding:32px 32px 0 32px;">
<p style="margin:0 0 12px 0; font-family:{{ font_display }}; font-weight:600; font-size:14px; letter-spacing:0.04em; text-transform:uppercase; color:{{ electric_blue }};">
Sources
</p>
<ol style="margin:0; padding-left:20px; font-family:{{ font_body }}; font-size:14px; line-height:1.7; color:{{ system_gray }};">
{% for source in sources %}
<li style="margin-bottom:6px;"><a href="{{ source.url }}" style="color:{{ system_gray }};">{{ source.title }}</a></li>
{% endfor %}
</ol>
</td>
</tr>

<!-- Footer -->
<tr>
<td style="background-color:{{ monk_black }}; padding:24px 32px; margin-top:24px;">
<p style="margin:0 0 6px 0; font-family:{{ font_mono }}; font-size:12px; letter-spacing:0.05em; color:{{ system_gray }};">
{{ tagline }}
</p>
<p style="margin:0; font-family:{{ font_body }}; font-size:12px; line-height:1.5; color:{{ system_gray }};">
Monk10x &mdash; AI Automation &amp; Digital Systems.
</p>
</td>
</tr>

</table>
</td></tr>
</table>
</body>
</html>
